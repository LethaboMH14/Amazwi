# AMAZWI backend environment
#
# Copy this file to `.env` in the SAME directory and fill in the values.
#   cp .env.example .env
#
# `.env` is gitignored; this template is not. Never put a real key in
# this file -- it is committed.

# --- required to run at all -------------------------------------------

# The DEMO database. Must NOT be the same database the tests use:
# tests/conftest.py drops the public schema per test, so pointing the
# demo at the test database wipes every seeded card, user and reward.
# See DEMO_RUNBOOK.md.
AMAZWI_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/amazwi_demo

# Signs the short-lived, audience-bound audio playback tokens.
# Any long random string for local work. Rotate for anything real.
AMAZWI_AUDIO_TOKEN_SECRET=change-me-to-a-long-random-string

# Where private audio is written. Gitignored -- it holds real consented
# voice recordings and must never enter the repository.
AMAZWI_PRIVATE_AUDIO_ROOT=.private_audio


# --- Featherless AI (advisory Council) ---------------------------------
#
# PUT YOUR FEATHERLESS TOKEN IN `AMAZWI_FEATHERLESS_API_KEY` BELOW.
#
# Featherless is an OpenAI-compatible serverless host for open-weight
# models. The base URL below is theirs and does not change.
#
# What Featherless serves, checked against their model-compatibility
# docs rather than assumed:
#   * 4,000+ text generation models (Llama, Qwen, Mistral, Gemma, ...)
#   * TEXT-TO-SPEECH: Kokoro 82M, Qwen3-TTS, Chatterbox, F5-TTS,
#     CSM-1B, Dia 1.6B, Orpheus 3B
#   * PRIVATE models from a connected Hugging Face account -- scale
#     plan, up to 10 slots, safetensors + FP16 + model card, <=72B.
#     That is the slot AMAZWI's own fine-tuned model would eventually
#     occupy, which closes the loop: contribute -> corpus -> train ->
#     serve your own model back to the people who built it.
#   * NOT speech-to-text. No Whisper, wav2vec2 or w2v-BERT. So nothing
#     routed through Featherless can LISTEN to a contribution -- ASR has
#     to run elsewhere (see AMAZWI_ASR_* below).
#
# What it IS used for here: the advisory Council in app/council.py --
# text-only specialists that read the card, the two typed peer answers
# and the decision, and write an explanation. The Council is ADVISORY:
# it can never overturn peer truth, and nothing it returns changes a
# payment. Leave the key blank and the Council falls back to the
# existing deterministic rule-based specialists.
AMAZWI_FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
AMAZWI_FEATHERLESS_API_KEY=
AMAZWI_FEATHERLESS_MODEL=

# --- Groq (low-latency advisory tasks) ----------------------------------
# Groq's OpenAI-compatible endpoint. It is preferred for `fast` tasks and
# participates in the configurable provider fallback order.
AMAZWI_GROQ_BASE_URL=https://api.groq.com/openai/v1
AMAZWI_GROQ_API_KEY=
AMAZWI_GROQ_MODEL=

# --- Featherless TTS: read the card aloud --------------------------------
#
# The strongest use of Featherless for this product, and the one worth
# showing a judge. Written literacy in isiZulu and Setswana is markedly
# lower than spoken fluency, so a game that requires READING the target
# word excludes exactly the fluent speakers whose voices the corpus most
# needs. If the card can speak itself, that barrier goes.
#
# UNVERIFIED, and do not claim otherwise until it is: none of the TTS
# models above has been checked for isiZulu or Setswana coverage. Most
# open TTS is English-first. Test the voice before promising the feature.
AMAZWI_TTS_MODEL=
AMAZWI_TTS_ENABLED=false

# --- AIML API (alternative provider) ------------------------------------
#
# PUT YOUR AIML TOKEN IN `AMAZWI_AIML_API_KEY` BELOW.
# Also OpenAI-compatible. Used only if the Featherless key is blank,
# so you can switch provider without touching code.
AMAZWI_AIML_BASE_URL=https://api.aimlapi.com/v1
AMAZWI_AIML_API_KEY=
AMAZWI_AIML_MODEL=

# Comma-separated provider order for general assistant work. Unknown names
# are ignored. Task defaults are: fast=groq,featherless,aiml and
# reasoning=featherless,aiml,groq.
AMAZWI_AI_PROVIDER_ORDER=groq,featherless,aiml

# Hard off-switch. The Council stays disabled unless this is true, even
# with a key present -- a key on disk must never be enough to start
# spending someone's credit or sending contribution text off the box.
AI_COUNCIL_ENABLED=false


# --- speech recognition (NOT Featherless) --------------------------------
#
# Left blank on purpose. No ASR is wired yet, and none of the candidates
# below has been benchmarked on our own data -- see BUILD_LOG.md. Do not
# describe any of this as working until a real WER number exists.
#
# Candidates found for isiZulu (all Hugging Face, all need a GPU host):
#   uctnlp/omniASR-CTC-1B-v2-Zulu-All   University of Cape Town, Aug 2026
#   badrex/w2v-bert-2.0-zulu-asr        w2v-BERT 2.0, 215 downloads
#   asr-africa/whisper_NCHLT_..._Zulu   gated, needs access request
#
# Setswana has no MMS adapter at all (facebook/mms-1b-all ships adapter
# .zul, .xho, .nso, .tso -- there is no .tsn), which is the gap AMAZWI
# exists to close.
AMAZWI_ASR_BASE_URL=
AMAZWI_ASR_API_KEY=
AMAZWI_ASR_MODEL=


# --- demo-only guards ----------------------------------------------------
# Both refuse to run unless explicitly set to true.
AMAZWI_ALLOW_DEMO_SEED=false
AMAZWI_ALLOW_DEMO_RESET=false
